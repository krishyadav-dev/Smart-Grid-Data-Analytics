# Listener settings (copy to .env).  All optional; defaults shown.
SG_FEEDER_ID=ieee13_11kv
SG_METERS_FILE=config/meters.yaml
SG_MQTT_HOST=127.0.0.1
SG_MQTT_PORT=1883
SG_MQTT_CLIENT_ID=sg-listener
SG_MQTT_KEEPALIVE_S=10
SG_MQTT_PERSISTENT_SESSION=true
SG_BACKOFF_INITIAL_S=0.5
SG_BACKOFF_MAX_S=15
SG_BACKOFF_JITTER=0.3
SG_OUT_OF_ORDER_POLICY=flag
SG_STALE_AFTER_S=30
SG_EXPECTED_STEP_S=900
SG_DEDUP_WINDOW=1024
SG_HISTORY_LEN=96
SG_HUB_QUEUE_SIZE=1000
SG_LATENCY_SAMPLE_SIZE=10000
SG_RATE_WINDOW_S=60
# SG_LATENCY_BUDGET_MS is intentionally unset (owner decides from benchmarks)
